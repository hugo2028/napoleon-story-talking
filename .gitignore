.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

.env
.env.*
!.env.example
*.pem

web/.env
web/.env.*
web/node_modules/
web/dist/

# data/ reste local : les bases RAG se téléchargent depuis la Release GitHub
# (python scripts/download_data.py)
data/
shards/logs/
*.log

napoleon-corpus/datasets/sft/batch/responses/
napoleon-corpus/datasets/sft/batch/requests/
napoleon-corpus/datasets/sft/batch/manifests/

napoleon-corpus/napoleon.db
napoleon-corpus/sources/pdfs/
napoleon-corpus/sources/texts/

# Modèles 3D et rendus : non distribués (fournissez votre propre avatar, voir README)
web/avatar/
*.glb
*.gltf
*.fbx
*.blend
*.blend1

# Vidéos de démo (hébergées hors du dépôt)
*.webm
*.mp4
*.mov

# Corpus source et scripts de lots (non publiés), sauf la chronologie et les pages Gallica lues par
# l'API, et les tables des matières Gallica dont ces pages sont tirées (scripts/build_gallica_pages.py)
napoleon-corpus/*
!napoleon-corpus/metadata/
napoleon-corpus/metadata/*
!napoleon-corpus/metadata/events_timeline.json
!napoleon-corpus/metadata/gallica_pages.json
!napoleon-corpus/gallica_services/
!napoleon-corpus/sources/
shards/
