# ─────────────────────────────────────────────────────────────────────────────
# Napoleon_project — variables d'environnement
# Le plus simple : lancer l'application et tout régler dans « ⚙ Paramètres » (les valeurs sont
# alors écrites ici). Sinon, copier ce fichier en ".env" à la racine du projet et le remplir.
# Lu par l'API Python (pipeline/) et par web/server.js.
# Les lignes commentées sont optionnelles : la valeur indiquée est le défaut du code.
# Ne pas laisser une variable optionnelle vide (VAR=) : le code Python lirait "" au lieu du défaut.
# ─────────────────────────────────────────────────────────────────────────────

# ── Modèle de l'agent (REQUIS) : archiviste + narrateur ──────────────────────
# Toute API compatible OpenAI : OpenAI, Anthropic, Mistral, Gemini, OpenRouter, Groq, Ollama…
# URL de l'API (défaut : OpenAI). Ex. https://api.mistral.ai/v1, http://localhost:11434/v1
# LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Modèles choisis dans la liste du fournisseur (« Paramètres » les propose depuis son API)
# AGENT_MODEL=gpt-4.1
# LLM_MODEL=gpt-4.1-mini

# ── Recherche sémantique (optionnelle) ───────────────────────────────────────
# Clé OpenAI pour les embeddings (les bases ont été indexées avec text-embedding-3-small).
# Inutile si le fournisseur est OpenAI : LLM_API_KEY sert aussi aux embeddings.
# Sans clé d'embeddings, l'archiviste cherche par mots-clés.
# EMBEDDING_API_KEY=

# ── Voix Azure Speech (optionnelle) ──────────────────────────────────────────
# Sans Azure : voix du navigateur, gratuite. Avec Azure : voix neuronale + lèvres synchronisées.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=francecentral
# Alternative à la région : endpoint complet de la ressource Speech
# AZURE_ENDPOINT=

# ── Réglages avancés ─────────────────────────────────────────────────────────
# NAPOLEON_API_PORT=5001
# Pilotage du récit : autonome (archiviste à outils, défaut) ou classique (ancien pipeline)
# AGENT_MODE=autonome
# Nombre maximal d'appels d'outils de l'archiviste par tour
# AGENT_MAX_STEPS=14
# URL de l'API Python et port du serveur Node
# NAPOLEON_API_URL=http://localhost:5001
# PORT=3002

# ── Interface ────────────────────────────────────────────────────────────────
# Bouton « Enregistrer » une vidéo de démo de l'onglet (masqué par défaut)
# VITE_DEMO_RECORDER=true
