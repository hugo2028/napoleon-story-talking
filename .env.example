# ─────────────────────────────────────────────────────────────────────────────
# Napoleon_project — variables d'environnement
# Copier ce fichier en ".env" à la racine du projet et remplir les valeurs.
# Lu par l'API Python (pipeline/) et par web/server.js.
# Les lignes commentées sont optionnelles : la valeur indiquée est le défaut du code.
# Ne pas laisser une variable optionnelle vide (VAR=) : le code Python lirait "" au lieu du défaut.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM / OpenAI (obligatoire : archiviste et narrateur) ───────────────
LLM_API_KEY=
# Alias acceptés à la place de LLM_API_KEY :
# OPENAI_API_KEY=
# OPEN_AI_KEY=
# Modèle de l'agent (napoleon_api.py, napoleon_agent.py) :
# LLM_MODEL=gpt-4.1-mini

# ── LLM local optionnel (napoleon_agent.py, ex. Ollama) ──────────────────────
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_KEY=ollama

# ── API Python Napoléon (napoleon_api.py) ────────────────────────────────────
# NAPOLEON_API_PORT=5001
# Pilotage du récit : autonome (archiviste à outils, défaut) ou classique (ancien pipeline)
# AGENT_MODE=autonome
# Modèle de l'archiviste (la narration de Napoléon utilise LLM_MODEL)
# AGENT_MODEL=gpt-4.1
# Nombre maximal d'appels d'outils de l'archiviste par tour
# AGENT_MAX_STEPS=14

# ── Application web (web/server.js) ──────────────────────────────────────────
# Azure Speech : voix + visèmes (obligatoire pour faire parler l'avatar)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Alternative à la région : endpoint complet de la ressource Speech
# AZURE_ENDPOINT=
# Fournisseur de voix : azure (défaut) ou elevenlabs (Azure reste requis pour les visèmes)
# TTS_PROVIDER=azure
# ElevenLabs (seulement si TTS_PROVIDER=elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# URL de l'API Python et port du serveur Node
# NAPOLEON_API_URL=http://localhost:5001
# PORT=3002
